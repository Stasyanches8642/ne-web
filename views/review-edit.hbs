<section class="review-form-section">
    <h2>Редактировать отзыв</h2>
    <form action="/review/{{review.id}}/update" method="POST">
        <label>Оценка (1–5):
            <input type="number" name="rating" min="1" max="5" value="{{review.rating}}" required>
        </label>
        <label>Комментарий:
            <textarea name="text" minlength="3" placeholder="Опишите качество еды, обслуживания и общие впечатления">{{review.text}}</textarea>
        </label>
        <button type="submit">Сохранить изменения</button>
        <a href="/reviews" class="button">Отмена</a>
    </form>

    <form action="/review/{{review.id}}/delete" method="POST" style="margin-top: 20px;">
        <button type="submit" style="background-color: #c0392b; color: white; border-color: #c0392b;">Удалить отзыв</button>
    </form>
</section>
