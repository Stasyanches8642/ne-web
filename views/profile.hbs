<section class="person-info">
    <h1>Личная информация</h1>
    <form action="/profile" method="POST">
        <p><label>Фамилия<input type="text" name="surname" placeholder="Иванов" required></label></p>
        <p><label>Имя<input type="text" name="name" placeholder="Иван" required></label></p>
        <p><label>Отчество<input type="text" name="patronymic" placeholder="Иванович"></label></p>
        <p><label>Телефон<input type="tel" name="phone" placeholder="+79876543210" required></label></p>
        <p><label>Дата рождения<input type="date" name="birthday"></label></p>
        <p><label>Email<input type="email" name="email" placeholder="Example@mail.ru"></label></p>
        <button type="submit">Сохранить изменения</button>
    </form>
</section>
