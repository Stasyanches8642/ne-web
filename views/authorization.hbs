<div class="authorization-container">
    <form class="authorization-form" action="/authorization" method="POST">
        <h1>Вход в аккаунт</h1>
        <label>Введите номер телефона:<input type="tel" name="phone" placeholder="+79876543210"></label>
        <label>Введите код из SMS:<input type="number" name="code" minlength="6" maxlength="6" placeholder="000000"></label>
        <button type="submit">Проверить данные</button>
    </form>
</div>
