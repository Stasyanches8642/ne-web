<li class="dish-item">
    <button><img src="/htdocs/img/meals/{{image}}" alt="Фото блюда '{{name}}'"></button>
    <p class="dish-name">{{name}}</p>
    <p>{{description}}</p>
    <p>{{ingredients}}</p>
    {{#if vegetarian}}<p><em>Подходит для вегетарианцев.</em></p>{{/if}}
    <p class="price"><strong>{{price}}</strong></p>
</li>
