</section>

<form action="" method="get">
    <p><label for="surname">Фамилия:</label><input type="text" id="surname" required></p>
    <p><label for="name">Имя:</label><input type="text" id="name" required></p>
    <p><label for="phone">Телефон:</label><input type="tel" id="phone" required></p>
    <p><label for="email" lang="en">Email:</label><input type="email" id="email" required></p>
    <p>
        <label for="time">Время:</label>
        <select id="time" required>
            <option value="">Выберите время</option>
            <option value="morning">10:00-16:00</option>
            <option value="evening">16:00-22:00</option>
            <option value="full">10:00-22:00 (Полный день)</option>
        </select>
    </p>
    <p><label for="guests">Количество гостей:</label><input type="number" id="guests" min="1" required></p>
    <button type="submit">Забронировать</button>
</form>
